# Copy this file to .env and fill it in. .env is never committed.
# Both values are sent to the browser (that is what PUBLIC_ means), which is
# how Web3Forms and Apps Script web apps are meant to be used. Do not put
# anything secret here.

# Web3Forms access key. Create it at https://web3forms.com using the email
# address that should receive orders; every order is emailed to that address.
PUBLIC_WEB3FORMS_KEY=

# Optional. URL of a Google Apps Script web app (ends in /exec) that receives a
# copy of each order as JSON in the POST body. Leave empty to skip.
PUBLIC_ORDER_SCRIPT_URL=
