---
// Small line sketches for "How it's made". Each shows something the kitchen
// photos show, with a wash of colour behind it (data-tone) that fades in
// after the lines are drawn.
interface Props {
  kind: 'cups' | 'tray' | 'fridge' | 'pack';
  class?: string;
}

const { kind, class: className } = Astro.props;
// The second colour of each sketch: a flavour's colour, thinned with cream.
const tones = { cups: '#C89B3C', tray: '#6F4E37', fridge: '#5B3FA0', pack: '#D2232A' } as const;
const tone = `color-mix(in srgb, ${tones[kind]} 26%, var(--color-cream))`;
// A paper cup seen from the side, standing at x, y.
const cup = (x: number, y: number): string =>
  `M${x - 13} ${y - 20}L${x - 9} ${y}H${x + 9}L${x + 13} ${y - 20}ZM${x - 5} ${y - 20}L${x - 3} ${y}M${x + 5} ${y - 20}L${x + 3} ${y}`;
---

<svg
  class={className}
  viewBox="0 0 100 80"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-sketch
  style={`--tone:${tone}`}
>
  <ellipse cx="54" cy="44" rx="34" ry="26" data-tone></ellipse>
  {
    kind === 'cups' && (
      <>
        <path d={cup(28, 62)} />
        <path d={cup(52, 58)} />
        <path d={cup(74, 64)} />
        <path d="M16 70H88" stroke-width="1" opacity="0.5" />
      </>
    )
  }
  {
    kind === 'tray' && (
      <>
        <rect x="14" y="16" width="72" height="50" rx="6" />
        <rect x="20" y="22" width="60" height="38" rx="3" stroke-width="1" opacity="0.5" />
        <circle cx="34" cy="34" r="7" />
        <circle cx="50" cy="34" r="7" />
        <circle cx="66" cy="34" r="7" />
        <circle cx="34" cy="50" r="7" />
        <circle cx="50" cy="50" r="7" />
        <circle cx="66" cy="50" r="7" />
      </>
    )
  }
  {
    kind === 'fridge' && (
      <>
        <rect x="30" y="8" width="40" height="64" rx="5" />
        <path d="M30 32H70" />
        <path d="M36 16v9M36 40v14" />
        <path d="M52 50l8 8M60 50l-8 8M56 48v12M50 54h12" stroke-width="1.25" />
      </>
    )
  }
  {
    kind === 'pack' && (
      <>
        <rect x="8" y="26" width="84" height="28" rx="5" />
        <path d="M14 21H86" stroke-width="1" opacity="0.5" />
        <circle cx="20" cy="40" r="7" />
        <circle cx="35" cy="40" r="7" />
        <circle cx="50" cy="40" r="7" />
        <circle cx="65" cy="40" r="7" />
        <circle cx="80" cy="40" r="7" />
      </>
    )
  }
</svg>
