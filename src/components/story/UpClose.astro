---
// Real photos of the bites, side on. A flavour appears here once it has a
// photo at src/assets/photos/bite-<id>.webp.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { flavours } from '../../content/flavours';
import { upClose } from '../../content/story';
import HandNote from '../ui/HandNote.astro';
import SectionTitle from '../ui/SectionTitle.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/bite-*.webp', { eager: true });
const shots = flavours.flatMap((flavour) => {
  const photo = photos[`../../assets/photos/bite-${flavour.id}.webp`]?.default;
  return photo ? [{ flavour, photo }] : [];
});
---

{
  shots.length > 0 && (
    <section class="overflow-x-clip px-5 py-20" data-up-close>
      <SectionTitle label={upClose.label} title={upClose.heading} />

      <p class="mx-auto mt-8 flex max-w-4xl justify-start pl-[8%]">
        <HandNote>{upClose.note}</HandNote>
      </p>
      <ul class="mx-auto mt-2 grid max-w-5xl grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-6">
        {shots.map(({ flavour, photo }) => (
          <li data-up-close-shot>
            <figure class="warm-glow">
              <Picture
                src={photo}
                formats={['avif']}
                fallbackFormat="webp"
                quality={78}
                widths={[240, 400, 600]}
                sizes="(min-width: 40rem) 22vw, 44vw"
                alt={`A ${flavour.name} cheesecake bite in its paper cup, seen from the side`}
                class="aspect-[4/5] w-full rounded-2xl border border-wine/25 object-cover"
              />
              <figcaption class="label-caps mt-3 text-center text-[0.65rem] sm:text-xs">{flavour.name}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style is:global>
  /* The "motion" class is set in Base.astro only when motion is allowed. */
  .motion [data-up-close]:not([data-ready]) [data-up-close-shot] {
    opacity: 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { lazyScene } from '../../lib/scene';

  gsap.registerPlugin(ScrollTrigger);

  // The photos rise into place one after another.
  lazyScene('[data-up-close]', (scene) => {
    scene.dataset.ready = '';
    gsap.from(scene.querySelectorAll('[data-up-close-shot]'), {
      opacity: 0,
      y: 32,
      duration: 1,
      stagger: 0.12,
      ease: 'expo.out',
      scrollTrigger: { trigger: scene, start: 'top 75%', once: true },
    });
  });
</script>
