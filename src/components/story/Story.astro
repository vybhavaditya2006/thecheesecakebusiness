---
// Our Story: Shlok's photo and his story, side by side on wide screens
// (photo left, text right), one above the other on phones.
import { Picture } from 'astro:assets';
import { story } from '../../content/story';
import { PHOTO_WIDTHS, photo, QUALITY } from '../../lib/photos';
import Frame from '../v3/Frame.astro';
import Label from '../v3/Label.astro';
import Reveal from '../v3/Reveal.astro';

const picture = photo('shlok');
---

<section class="px-4 pt-12 pb-16 sm:px-6 sm:pt-20 sm:pb-24" aria-labelledby="story-heading">
  <div class="mx-auto grid max-w-5xl items-start gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-16">
    <Reveal>
      <Frame as="figure">
        {
          picture && (
            <div class="bg-blush/50">
              <Picture
                src={picture}
                formats={['avif']}
                fallbackFormat="webp"
                quality={QUALITY.other}
                widths={PHOTO_WIDTHS}
                sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 40vw, calc(100vw - 2.8rem)"
                alt={story.caption}
                loading="eager"
                class="mx-auto aspect-[4/5] w-full object-contain object-bottom"
              />
            </div>
          )
        }
        <figcaption class="label-caps px-1 pt-3 pb-1 text-[0.65rem]">{story.caption}</figcaption>
      </Frame>
    </Reveal>

    <Reveal delay={0.1} class="md:pt-6">
      <Label>{story.label}</Label>
      <h1 id="story-heading" class="mt-3 text-5xl leading-tight font-semibold sm:text-6xl">{story.heading}</h1>
      <div class="mt-8 max-w-prose space-y-5 text-lg leading-relaxed">
        {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Reveal>
  </div>
</section>
