---
// Line sketches for the story timeline. Every shape is a stroke so DrawSVG
// can draw it; groups marked data-pop scale in after the lines are drawn.
import Bow from '../ui/Bow.astro';

interface Props {
  kind: 'cake' | 'phone' | 'slice' | 'box' | 'door';
  class?: string;
}

const { kind, class: className } = Astro.props;
// The second colour of each sketch: a flavour's colour, thinned with cream.
const tones = {
  cake: '#5B3FA0',
  phone: '#6F4E37',
  slice: '#C8813C',
  box: '#D2232A',
  door: '#C89B3C',
} as const;
const tone = `color-mix(in srgb, ${tones[kind]} 26%, var(--color-cream))`;
const flame = (x: number, y: number): string => `M${x} ${y}c-4-6 0-9 0-12 3 3 4 7 0 12z`;
---

<svg
  class={className}
  viewBox="0 0 200 150"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-sketch
  style={`--tone:${tone}`}
>
  <!-- The wash of colour behind the drawing, a little off-register. -->
  <ellipse cx="108" cy="88" rx="64" ry="50" data-tone data-pop></ellipse>
  {
    kind === 'cake' && (
      <>
        <path d="M30 128H170" />
        <path d="M48 128V92H152V128" />
        <path d="M48 92c8 10 16 10 26 0s18 10 26 0 18 10 26 0 18 10 26 0" />
        <path d="M70 92V64H130V92" />
        <path d="M70 64c7 8 13 8 20 0s13 8 20 0 13 8 20 0" />
        <path d="M88 64V46M100 64V42M112 64V46" />
        <path d={flame(88, 46) + flame(100, 42) + flame(112, 46)} />
        <path d="M60 112h8M86 116h8M112 110h8M134 116h8" stroke-width="1" opacity="0.5" />
      </>
    )
  }
  {
    kind === 'phone' && (
      <>
        <rect x="70" y="18" width="60" height="114" rx="10" />
        <path d="M92 28h16" />
        <circle cx="100" cy="122" r="4" />
        <g data-pop>
          <path
            class="fill-cream"
            d="M14 44a6 6 0 0 1 6-6h38a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6H32l-8 8v-8h-4a6 6 0 0 1-6-6z"
          />
          <path d="M24 51h26" />
        </g>
        <g data-pop>
          <path
            class="fill-cream"
            d="M136 62a6 6 0 0 1 6-6h38a6 6 0 0 1 6 6v14a6 6 0 0 1-6 6h-4v8l-8-8h-20a6 6 0 0 1-6-6z"
          />
          <path d="M146 69h28" />
        </g>
        <g data-pop>
          <path
            class="fill-cream"
            d="M18 96a6 6 0 0 1 6-6h30a6 6 0 0 1 6 6v12a6 6 0 0 1-6 6H36l-8 8v-8h-4a6 6 0 0 1-6-6z"
          />
          <path d="M28 102h20" />
        </g>
      </>
    )
  }
  {
    kind === 'slice' && (
      <>
        <path d="M14 112H80V60L14 104Z" />
        <path d="M14 108L80 96M30 96l50-26" stroke-width="1" opacity="0.5" />
        <path d="M94 88h26m-8-7 8 7-8 7" />
        <g data-pop>
          <circle cx="146" cy="58" r="12" />
        </g>
        <g data-pop>
          <circle cx="172" cy="88" r="12" />
        </g>
        <g data-pop>
          <circle cx="146" cy="118" r="12" />
        </g>
      </>
    )
  }
  {
    kind === 'box' && (
      <>
        <path d="M48 78L54 50H146L152 78" />
        <path d="M55 78a9 9 0 0 1 18 0M73 78a9 9 0 0 1 18 0M91 78a9 9 0 0 1 18 0M109 78a9 9 0 0 1 18 0M127 78a9 9 0 0 1 18 0" />
        <path d="M40 78H160L156 128H44Z" />
        <path d="M42 102H158" stroke-width="7" stroke-linecap="butt" />
        <g data-pop>
          <Bow x="72" y="86" width="56" height="29" class="[&_ellipse]:fill-wine [&_path]:fill-cream" />
        </g>
      </>
    )
  }
  {
    kind === 'door' && (
      <>
        <path d="M22 132H178" />
        <path d="M62 132V26H138V132" />
        <path d="M72 36H128V78H72Z" stroke-width="1" opacity="0.5" />
        <circle cx="126" cy="92" r="3" />
        <g data-pop>
          <path class="fill-cream" d="M112 132l3-26h44l3 26z" />
          <path d="M114 118h46" stroke-width="5" stroke-linecap="butt" />
          <Bow x="122" y="108" width="30" height="16" class="[&_ellipse]:fill-wine [&_path]:fill-cream" />
        </g>
      </>
    )
  }
</svg>
