---
// How it's made: four short numbered steps, each beside a real kitchen photo
// when there is one for it, and text only when there is not.
import { Picture } from 'astro:assets';
import { kitchen } from '../../content/photos';
import { howItsMade } from '../../content/story';
import { PHOTO_WIDTHS, photo, qualityOf } from '../../lib/photos';
import Frame from '../v3/Frame.astro';
import Reveal from '../v3/Reveal.astro';
import Section from '../v3/Section.astro';

const steps = howItsMade.steps.map((step) => {
  const shot = step.photo ? kitchen.find((one) => one.name === step.photo) : undefined;
  return { ...step, shot, picture: shot ? photo(shot.name) : undefined };
});
---

<Section heading={howItsMade.heading} id="how-its-made" class="border-t border-[var(--color-hairline)]">
  <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {
      steps.map((step, index) => (
        <Reveal as="li" delay={index * 0.06} class="flex flex-col justify-end">
          {step.picture && step.shot && (
            <Frame class="mb-5">
              <Picture
                src={step.picture}
                formats={['avif']}
                fallbackFormat="webp"
                quality={qualityOf(step.shot.name)}
                widths={PHOTO_WIDTHS}
                sizes="(min-width: 72rem) 15rem, (min-width: 64rem) 22vw, (min-width: 40rem) 45vw, calc(100vw - 2.8rem)"
                alt={step.shot.alt}
                class="aspect-square w-full object-cover"
              />
            </Frame>
          )}
          <p class="flex items-baseline gap-4 border-t border-[var(--color-hairline)] pt-4">
            <span class="font-display text-3xl leading-none tabular-nums opacity-70" aria-hidden="true">
              {index + 1}
            </span>
            <span>
              <span class="block font-display text-2xl leading-tight">{step.title}</span>
              <span class="mt-1 block text-sm">{step.detail}</span>
            </span>
          </p>
        </Reveal>
      ))
    }
  </ol>
</Section>
