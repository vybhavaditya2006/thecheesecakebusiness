---
// Page transition (v3): one for every page. A plain wine sheet slides in from
// the left to cover the page being left, then on out to the right to show
// the page arriving. With reduced motion it is a short fade instead.
---

<div id="page-curtain" aria-hidden="true" transition:persist="page-curtain">
  <div class="curtain-sheet absolute inset-0 bg-wine" data-curtain="sheet"></div>
</div>

<style is:global>
  #page-curtain {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: clip;
    pointer-events: none;
  }

  /* Resting place: off to the left, out of sight. */
  .curtain-sheet {
    transform: translateX(-101%);
  }
</style>

<script>
  import gsap from 'gsap';
  import { setCurtainBusy } from '../../lib/curtain-state';
  import { reducedMotion } from '../../lib/motion';

  // How far into the reveal the scenes behind it may start (seconds).
  const CLEAR_AFTER = 0.4;

  let covered = false;
  let markClear = (): void => {};

  const root = (): HTMLElement | null => document.getElementById('page-curtain');
  const sheet = (): HTMLElement | null => root()?.querySelector<HTMLElement>('[data-curtain="sheet"]') ?? null;

  // Back to the stylesheet's resting state, ready for the next page change.
  const reset = (): void => {
    const parts = [root(), sheet()].filter(Boolean) as HTMLElement[];
    gsap.killTweensOf(parts);
    gsap.set(parts, { clearProps: 'transform,opacity' });
  };

  const cover = async (): Promise<void> => {
    if (!root()) return;
    reset();
    if (reducedMotion()) {
      gsap.set(sheet(), { xPercent: 0 });
      await gsap.fromTo(root(), { opacity: 0 }, { opacity: 1, duration: 0.2 });
    } else {
      await gsap.fromTo(sheet(), { xPercent: -101 }, { xPercent: 0, duration: 0.55, ease: 'power3.inOut' });
    }
    covered = true;
  };

  const reveal = async (): Promise<void> => {
    if (!root() || !covered) return markClear();
    covered = false;
    if (reducedMotion()) {
      markClear();
      await gsap.to(root(), { opacity: 0, duration: 0.2 });
      return reset();
    }
    setTimeout(markClear, CLEAR_AFTER * 1000);
    await gsap.to(sheet(), { xPercent: 101, duration: 0.6, ease: 'power3.inOut', delay: 0.08 });
    reset();
  };

  // Hold the swap until the curtain covers the screen and the page is fetched.
  document.addEventListener('astro:before-preparation', (event) => {
    const load = event.loader;
    setCurtainBusy(new Promise((resolve) => (markClear = resolve)));
    event.loader = async () => {
      await Promise.all([cover(), load()]);
    };
  });

  document.addEventListener('astro:page-load', reveal);
</script>
