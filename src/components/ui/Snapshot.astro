---
// One photo from the kitchen: a tilted print in a warm glow, with an
// optional hand-written note above it. Renders nothing until its master
// exists in src/assets/photos/masters.
import { Picture } from 'astro:assets';
import type { Snapshot } from '../../content/photos';
import { PHOTO_WIDTHS, photo as master, qualityOf } from '../../lib/photos';
import HandNote from './HandNote.astro';

interface Props {
  shot: Snapshot;
  // Degrees of tilt.
  tilt?: number;
  // The rendered width, as a `sizes` attribute.
  sizes: string;
  class?: string;
}

const { shot, tilt = -2, sizes, class: className } = Astro.props;
const photo = master(shot.name);
---

{
  photo && (
    <figure class:list={['snapshot', className]} style={`--tilt:${tilt}deg`} data-snapshot>
      {shot.note && (
        <p class="mb-1 pl-[10%]">
          <HandNote tilt={-5}>{shot.note}</HandNote>
        </p>
      )}
      <div class="warm-glow contact-shadow snapshot-print">
        <Picture
          src={photo}
          formats={['avif']}
          fallbackFormat="webp"
          quality={qualityOf(shot.name)}
          widths={PHOTO_WIDTHS}
          sizes={sizes}
          alt={shot.alt}
          class="w-full rounded-xl"
        />
      </div>
    </figure>
  )
}

<style is:global>
  /* A print: a cream border, a slight tilt, a soft shadow. */
  .snapshot-print {
    padding: 0.5rem;
    border-radius: 1rem;
    background: var(--color-cream);
    box-shadow: 0 10px 22px -12px rgb(74 15 24 / 0.45);
    transform: rotate(var(--tilt));
  }

  /* The "motion" class is set in Base.astro only when motion is allowed. */
  .motion [data-snapshot]:not([data-ready]) {
    opacity: 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { lazyScene } from '../../lib/scene';

  gsap.registerPlugin(ScrollTrigger);

  // Each print rises into place as it comes into view.
  lazyScene('[data-snapshot]', (print) => {
    print.dataset.ready = '';
    gsap.from(print, {
      opacity: 0,
      y: 28,
      duration: 1,
      ease: 'expo.out',
      scrollTrigger: { trigger: print, start: 'top 85%', once: true },
    });
  });
</script>
