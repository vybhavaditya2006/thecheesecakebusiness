---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['flex items-center gap-4 text-wine', className]} role="separator">
  <span class="h-px flex-1 bg-gold/70"></span>
  <span class="size-1.5 shrink-0 rotate-45 bg-gold" aria-hidden="true"></span>
  <span class="h-px flex-1 bg-gold/70"></span>
</div>
