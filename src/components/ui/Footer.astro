---
import { brand } from '../../content/brand';
import { arrival, contact, delivery, payment } from '../../content/info';
import { boxLabel, navLinks, orderPath, paths } from '../../content/site';
import { whatsappLink } from '../../lib/whatsapp';
import Bow from './Bow.astro';
import Wordmark from './Wordmark.astro';

const links = [...navLinks, { href: orderPath, label: boxLabel }];
// The practical facts in their shortest form; Good to Know has them in full.
const facts = [delivery.short, arrival.short, payment.short];
---

<footer class="bg-wine-deep px-5 py-12 text-cream">
  <div class="mx-auto grid max-w-5xl gap-10 sm:grid-cols-3">
    <div>
      <Wordmark class="text-5xl" />
      <p class="label-caps mt-3">{brand.descriptor}</p>
    </div>

    <div>
      <h2 class="label-caps font-sans text-gold">Find your way</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="underline-offset-4 hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="label-caps font-sans text-gold">Get in touch</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          contact.whatsapp && (
            <li>
              <a
                href={whatsappLink(`Hi ${brand.name}!`)}
                class="underline-offset-4 hover:underline"
                rel="noopener"
              >
                WhatsApp
              </a>
            </li>
          )
        }
        {
          contact.email && (
            <li>
              <a href={`mailto:${contact.email}`} class="underline-offset-4 hover:underline">
                {contact.email}
              </a>
            </li>
          )
        }
      </ul>
      <a href={paths.info} class="label-caps mt-5 block text-[0.65rem] leading-relaxed underline-offset-4 hover:underline">
        {facts.join(' · ')}
      </a>
    </div>
  </div>

  <div class="mx-auto mt-10 flex max-w-5xl items-center gap-4 text-xs opacity-80">
    <Bow class="w-10" />
    <p>© {new Date().getFullYear()} {brand.name}. {delivery.area} {delivery.pincode}.</p>
  </div>
</footer>
