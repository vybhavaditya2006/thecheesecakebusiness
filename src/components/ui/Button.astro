---
// Wine pill. On hover it fades a touch lighter; nothing moves (v3).
interface Props {
  href?: string;
  variant?: 'solid' | 'outline' | 'cream';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
  [attribute: string]: unknown;
}

const {
  href,
  variant = 'solid',
  size = 'md',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const faces = {
  solid: 'bg-wine text-cream',
  outline: 'border border-wine text-wine',
  cream: 'bg-cream text-wine',
};
const sizes = {
  md: 'px-8 py-4',
  sm: 'px-5 py-2.5',
};
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn inline-block cursor-pointer rounded-full', className]}
  {...rest}
>
  <span class:list={['btn-face label-caps block rounded-full', faces[variant], sizes[size]]}>
    <slot />
  </span>
</Tag>

<style>
  .btn-face {
    transition: opacity 0.2s ease-out;
  }

  @media (hover: hover) {
    .btn:hover .btn-face {
      opacity: 0.88;
    }
  }

  .btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>
