---
// The practical facts as three icons with their shortest wording. The full
// sentences live on Good to Know, which this links to.
import { arrival, delivery, payment } from '../../content/info';
import { paths } from '../../content/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const facts = [
  { icon: 'delivery', label: delivery.short },
  { icon: 'clock', label: arrival.shortChoice },
  { icon: 'wallet', label: payment.short },
] as const;
---

<a href={paths.info} class:list={['fact-icons group', className]} aria-label="Delivery, timing and payment: see Good to Know">
  <ul class="flex flex-wrap items-start justify-center gap-x-10 gap-y-6">
    {
      facts.map((fact) => (
        <li class="flex w-28 flex-col items-center gap-3 text-center">
          <svg
            class="icon-sketch w-12"
            viewBox="0 0 40 40"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {fact.icon === 'delivery' && (
              <>
                {/* A scooter with a box on the back. */}
                <rect data-tone x="5" y="10" width="11" height="9" rx="1.5" />
                <rect x="5" y="10" width="11" height="9" rx="1.5" />
                <path d="M4 26h5M15 26h10l4-12h4M29 14l2 6" />
                <circle data-tone cx="12" cy="27" r="4" />
                <circle cx="12" cy="27" r="4" />
                <circle data-tone cx="31" cy="27" r="4" />
                <circle cx="31" cy="27" r="4" />
              </>
            )}
            {fact.icon === 'clock' && (
              <>
                <circle data-tone cx="20" cy="21" r="14" />
                <circle cx="20" cy="21" r="14" />
                <path d="M20 12v9l6 4M14 4h12" />
              </>
            )}
            {fact.icon === 'wallet' && (
              <>
                <path data-tone d="M5 13v16a4 4 0 0 0 4 4h24a2 2 0 0 0 2-2V17a2 2 0 0 0-2-2H9a4 4 0 0 1-4-2z" />
                <path d="M5 13a4 4 0 0 1 4-4h20v6" />
                <path d="M5 13v16a4 4 0 0 0 4 4h24a2 2 0 0 0 2-2V17a2 2 0 0 0-2-2H9a4 4 0 0 1-4-2z" />
                <circle cx="28" cy="24" r="2" />
              </>
            )}
          </svg>
          <span class="label-caps text-[0.65rem] leading-snug underline-offset-4 group-hover:underline">{fact.label}</span>
        </li>
      ))
    }
  </ul>
</a>
