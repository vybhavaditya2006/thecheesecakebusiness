---
// One bite: a cut-out photo of the real thing, standing on a soft shadow. A
// flavour without a photo yet shows a still of the 3D bite instead (see
// src/lib/bite-images.ts); with neither it is the placeholder: a cream circle
// with the flavour name, or whatever is passed as the slot.
import { Picture } from 'astro:assets';
import type { Flavour } from '../../content/flavours';
import { biteImage, bitePhoto } from '../../lib/bite-images';
import { CUTOUT_WIDTHS, QUALITY } from '../../lib/photos';

interface Props {
  flavour: Flavour;
  // The rendered width, as a `sizes` attribute, so the browser picks the
  // smallest file that is sharp enough.
  sizes: string;
  // Only for images in a page's first screen: load at once instead of lazily.
  priority?: boolean;
  // Classes for the placeholder's text (size, weight).
  class?: string;
}

const { flavour, sizes, priority = false, class: className } = Astro.props;
const photo = biteImage(flavour.id);
const alt = bitePhoto(flavour.id) ? `${flavour.name} cheesecake bite` : `${flavour.name} cheesecake bite, drawn`;
const frame = 'size-full rounded-full border-[1.5px] border-wine bg-cream';
---

{
  photo ? (
    <span class="bite-cutout relative block size-full">
      <span class="bite-cutout-shadow" aria-hidden="true" />
      <Picture
        src={photo}
        formats={['avif']}
        fallbackFormat="webp"
        quality={QUALITY.product}
        widths={CUTOUT_WIDTHS}
        sizes={sizes}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding={priority ? 'sync' : 'async'}
        class="size-full object-contain"
        pictureAttributes={{ class: 'relative block size-full' }}
      />
    </span>
  ) : (
    <span
      class:list={[
        'flex items-center justify-center p-[6%] text-center font-display leading-none font-semibold',
        frame,
        className,
      ]}
    >
      <slot>{flavour.name}</slot>
    </span>
  )
}
