---
// A tilted gold sticker. Its corner peels up under the pointer (see .sticker
// in global.css); with reduced motion it simply sits there.
interface Props {
  // Degrees of tilt.
  tilt?: number;
  round?: boolean;
  class?: string;
  [attribute: string]: unknown;
}

const { tilt = -8, round = false, class: className, ...rest } = Astro.props;
---

<span class:list={['sticker', round && 'sticker-round', className]} style={`--tilt:${tilt}deg`} {...rest}>
  <slot />
</span>
