---
// Letter-spaced caps label above a serif heading, revealed as one block (v3:
// no letter wave).
import Reveal from '../v3/Reveal.astro';

interface Props {
  label?: string;
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'center' | 'left';
  // For a heading at the very top of a page: shown at once, so the page has
  // its main heading before any script runs.
  immediate?: boolean;
  class?: string;
}

const {
  label,
  title,
  as: Heading = 'h2',
  align = 'center',
  immediate = false,
  class: className,
} = Astro.props;
const Wrap = immediate ? 'div' : Reveal;
---

<Wrap class:list={[align === 'center' ? 'text-center' : 'text-left', className]}>
  {label && <p class="label-caps opacity-80">{label}</p>}
  {label && <span class:list={['mt-3 block h-0.5 w-10 bg-gold', align === 'center' && 'mx-auto']} aria-hidden="true" />}
  <Heading class="mt-3 text-4xl leading-tight sm:text-5xl">
    {title}
  </Heading>
</Wrap>
