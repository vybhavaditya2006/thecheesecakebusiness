---
// The questions the blocks above do not already answer.
import { faq } from '../../content/info';
import { paths } from '../../content/site';
import Reveal from '../v3/Reveal.astro';
import Section from '../v3/Section.astro';
---

<Section label="Questions" heading="Asked a lot" id="faq">
  <Reveal class="mx-auto max-w-2xl border-t border-[var(--color-hairline)]">
    {
      faq.map((item) => (
        <details class="faq-item border-b border-[var(--color-hairline)]" name="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-2xl">
            {item.question}
            <span class="faq-mark relative text-2xl leading-none" aria-hidden="true">
              <span class="faq-plus">+</span>
              <span class="faq-minus absolute inset-0">−</span>
            </span>
          </summary>
          <p class="pb-6 text-sm">
            {item.answer}
            {item.link && (
              <>
                {' '}
                <a href={paths[item.link.page]} class="underline underline-offset-4">
                  {item.link.label}
                </a>
              </>
            )}
          </p>
        </details>
      ))
    }
  </Reveal>
</Section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .faq-plus,
  .faq-minus {
    transition: opacity 0.25s ease-out;
  }

  .faq-minus,
  .faq-item[open] .faq-plus {
    opacity: 0;
  }

  .faq-item[open] .faq-minus {
    opacity: 1;
  }
</style>
