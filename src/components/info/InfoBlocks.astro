---
// Good to Know: delivery, timing and payment as three plain blocks, each with
// a small line icon that says what it is about. This is where these facts are
// given in full.
import { arrival, delivery, payment } from '../../content/info';
import Reveal from '../v3/Reveal.astro';

const blocks = [
  { icon: 'pin', heading: delivery.heading, notes: [delivery.freeNote, delivery.paidNote] },
  { icon: 'clock', heading: arrival.heading, notes: arrival.notes },
  { icon: 'wallet', heading: payment.heading, notes: payment.notes },
] as const;
---

<section class="px-4 pb-6 sm:px-6" aria-label="Delivery, timing and payment">
  <ul class="mx-auto grid max-w-6xl border-t border-[var(--color-hairline)] md:grid-cols-3">
    {
      blocks.map((block, index) => (
        <Reveal
          as="li"
          delay={index * 0.06}
          class="border-b border-[var(--color-hairline)] py-8 md:border-b-0 md:px-8 md:py-10 md:first:pl-0 md:[&:not(:first-child)]:border-l"
        >
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {block.icon === 'pin' && (
              <>
                <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
                <circle cx="12" cy="10" r="2.3" />
              </>
            )}
            {block.icon === 'clock' && (
              <>
                <circle cx="12" cy="12" r="8.5" />
                <path d="M12 7.5V12l3 2" />
              </>
            )}
            {block.icon === 'wallet' && (
              <>
                <rect x="3.5" y="6.5" width="17" height="12" rx="2" />
                <path d="M3.5 10h17M15.5 14.5h2" />
              </>
            )}
          </svg>
          <h2 class="mt-4 font-display text-3xl leading-tight">{block.heading}</h2>
          <div class="mt-3 space-y-2 text-sm">
            {block.notes.map((note) => <p>{note}</p>)}
          </div>
        </Reveal>
      ))
    }
  </ul>
</section>
