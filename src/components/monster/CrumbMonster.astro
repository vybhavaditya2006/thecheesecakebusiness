---
// The Crumb Monster on an Astro page. The mood is set once, from the prop.
import { monsterMarkup, monsterViewBox, type Mood } from './markup';

interface Props {
  mood: Mood;
  class?: string;
}

const { mood, class: className } = Astro.props;
---

<svg class={className} viewBox={monsterViewBox} aria-hidden="true" data-monster={mood} set:html={monsterMarkup} />

<script>
  import { reducedMotion } from '../../lib/motion';
  import type { Mood } from './markup';
  import { createMonster, type Monster } from './rig';

  let monsters: Monster[] = [];

  document.addEventListener('astro:page-load', () => {
    monsters = Array.from(document.querySelectorAll<SVGSVGElement>('svg[data-monster]'), (svg) => {
      const monster = createMonster(svg, reducedMotion());
      monster.mood(svg.dataset.monster as Mood);
      return monster;
    });
  });

  document.addEventListener('astro:before-swap', () => {
    monsters.forEach((monster) => monster.destroy());
    monsters = [];
  });
</script>
