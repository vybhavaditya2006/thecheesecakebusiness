---
// The whole cake, in 3D: pinned and scrubbed by scroll. A whole blueberry
// cheesecake turns on cream linen and a wedge is cut out; the camera goes
// into the cut; the slice is shown from the side with its layers labelled,
// then pulled apart and broken into crumbs; and everything swirls into one
// bite that drops into the box of five, as the three reasons stamp in.
//
// It is only shown when 3D is in use (see the script); otherwise this section
// stays hidden and WhyBites, the drawn version of the same pitch, shows.
import { brand } from '../../content/brand';
import { cakeLayers } from '../../content/layers';
import { DIVE_SCROLL_VH } from '../../lib/three/dive-beats';

const [first, ...rest] = [...brand.wholeCake, brand.brokeDown];
---

<section class="dive" style={`--dive-scroll:${DIVE_SCROLL_VH}svh`} aria-labelledby="dive-heading" data-dive>
  <div class="dive-pin">
    <div class="absolute inset-0" data-dive-3d></div>

    <!-- Only shown if the 3D takes more than a second to arrive. -->
    <p class="dive-loading" data-dive-loading>
      <span class="dive-loading-mark" aria-hidden="true"></span>
      <span class="sr-only">Loading</span>
    </p>

    <!-- Opens from the middle to cover the view: the way into the cake. -->
    <span class="dive-mask" aria-hidden="true" data-dive-mask></span>

    <div class="dive-text">
      <h2 id="dive-heading" class="dive-line" data-dive-line>{first}</h2>
      {rest.map((line) => <p class="dive-line" data-dive-line>{line}</p>)}
    </div>

    <!-- The slice's layers, each hung on a thin line from where it meets the rim. -->
    <ul data-dive-labels>
      {
        cakeLayers.map((layer) => (
          <li class="dive-label" data-dive-label={layer.id}>
            <span class="dive-leader" aria-hidden="true" data-dive-leader />
            <span data-dive-label-text>
              <strong class="label-caps block text-[0.65rem] font-medium">{layer.name}</strong>
              <span class="block text-xs">{layer.note}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <ol class="dive-reasons">
      {
        brand.whyBites.reasons.map((reason) => (
          <li class="dive-reason" data-dive-reason>
            <strong class="block font-display text-2xl leading-tight font-semibold sm:text-3xl">{reason.title}</strong>
            <span class="mt-1 block text-xs sm:text-sm">{reason.line}</span>
          </li>
        ))
      }
    </ol>

    <!-- Sound is off unless the visitor turns it on. -->
    <button type="button" class="dive-sound" aria-pressed="false" data-dive-sound>
      <svg
        class="w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 9.5v5h3.5L12 18V6L7.5 9.5z"></path>
        <path class="dive-sound-on" d="M15.5 9.5a4 4 0 0 1 0 5M18 7a7.5 7.5 0 0 1 0 10"></path>
        <path class="dive-sound-off" d="M16 9.5l5 5M21 9.5l-5 5"></path>
      </svg>
      <span class="sr-only">Sound</span>
    </button>
  </div>
</section>

<style is:global>
  .dive {
    display: none;
  }

  /* Set by the script once 3D is going to be used on this visit. */
  html[data-dive-on] .dive {
    display: block;
    --dive-top: 6.25rem;
    height: calc(var(--dive-scroll) + 100svh - var(--dive-top));
  }

  html[data-dive-on] [data-why] {
    display: none;
  }

  .dive-pin {
    position: sticky;
    top: var(--dive-top);
    height: calc(100svh - var(--dive-top));
    overflow: clip;
  }

  /* The lines share one spot and take turns. */
  .dive-text {
    display: grid;
    position: absolute;
    inset: 4% 1.25rem auto;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }

  .dive-line {
    grid-area: 1 / 1;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4rem);
    font-style: italic;
    line-height: 1.05;
    /* A cream backing, so the line reads over the cake as well as the cloth. */
    padding: 0.12em 0.6em 0.2em;
    border-radius: 999px;
    background: rgb(243 231 218 / 0.9);
  }

  .dive-line + .dive-line {
    opacity: 0;
  }

  .dive-mask {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150vmax;
    height: 150vmax;
    margin: -75vmax 0 0 -75vmax;
    border-radius: 50%;
    background: var(--color-cream);
    transform: scale(0);
  }

  /* A label starts at the rim of the slice and runs out to the right. */
  .dive-label {
    display: flex;
    position: absolute;
    align-items: center;
    gap: 0.5rem;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .dive-leader {
    width: clamp(1.25rem, 6vw, 5rem);
    height: 1px;
    background: var(--color-wine);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  [data-dive-label-text] {
    opacity: 0;
  }

  .dive-reasons {
    display: grid;
    position: absolute;
    /* Clear of the sound button on phones. */
    inset: auto 1.25rem 4.5rem;
    gap: 0.5rem;
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
    pointer-events: none;
  }

  .dive-reason {
    opacity: 0;
  }

  @media (min-width: 48rem) {
    .dive-reasons {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      bottom: 8%;
    }
  }

  .dive-sound {
    display: flex;
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(122 31 43 / 0.4);
    border-radius: 50%;
    background: rgb(243 231 218 / 0.9);
  }

  .dive-sound[aria-pressed='true'] .dive-sound-off,
  .dive-sound[aria-pressed='false'] .dive-sound-on {
    display: none;
  }

  .dive-loading {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
  }

  .dive[data-loading] .dive-loading {
    display: flex;
  }

  /* A bite with a piece missing, turning. */
  .dive-loading-mark {
    width: 3rem;
    height: 3rem;
    border: 1.5px solid var(--color-wine);
    border-right-color: transparent;
    border-radius: 50%;
    animation: dive-turn 0.9s linear infinite;
  }

  @keyframes dive-turn {
    to {
      transform: rotate(1turn);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { DIVE } from '../../lib/three/dive-beats';
  import type { DiveCake, LabelPoints } from '../../lib/three/dive-cake';
  import { canUse3D, whenNear } from '../../lib/three/support';

  gsap.registerPlugin(ScrollTrigger);

  // How long a line takes to come in or go out, as a fraction of the scroll.
  const FADE = 0.03;
  // Show the loading mark if the 3D has not arrived after this long (ms).
  const SLOW_LOAD = 1000;

  // ---- The crunch: made on the spot, so there is no sound file to fetch.
  let audio: AudioContext | undefined;
  const crunch = (): void => {
    if (!audio) return;
    const seconds = 0.4;
    const buffer = audio.createBuffer(1, audio.sampleRate * seconds, audio.sampleRate);
    const samples = buffer.getChannelData(0);
    // A handful of sharp crackles, each dying away quickly.
    const cracks = [0, 0.03, 0.07, 0.11, 0.17, 0.24].map((start) => start * audio!.sampleRate);
    for (let index = 0; index < samples.length; index += 1) {
      let level = 0;
      for (const start of cracks) {
        if (index >= start) level += Math.exp(-(index - start) / (audio.sampleRate * 0.012));
      }
      samples[index] = (Math.random() * 2 - 1) * Math.min(1, level);
    }
    const source = audio.createBufferSource();
    source.buffer = buffer;
    const tone = audio.createBiquadFilter();
    tone.type = 'bandpass';
    tone.frequency.value = 2200;
    tone.Q.value = 0.6;
    const volume = audio.createGain();
    volume.gain.value = 0.3;
    source.connect(tone).connect(volume).connect(audio.destination);
    source.start();
  };

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('section[data-dive]');
    const mount = section?.querySelector<HTMLElement>('[data-dive-3d]');
    if (!section || !mount || !canUse3D()) return;

    const page = document.documentElement;
    let cake: DiveCake | undefined;
    let scrub: gsap.core.Timeline | undefined;
    let gone = false;

    // Swapping this section in for WhyBites (or back) moves everything below.
    // Re-measuring every scroll scene is costly, so it is only done when the
    // swap happens after the page has settled (the fallback), not on arrival.
    const swap = (use3D: boolean, remeasure = false): void => {
      page.toggleAttribute('data-dive-on', use3D);
      if (remeasure) requestAnimationFrame(() => ScrollTrigger.refresh());
    };
    const slow = window.setTimeout(() => section.toggleAttribute('data-loading', !cake), SLOW_LOAD);
    const loaded = (): void => {
      window.clearTimeout(slow);
      section.removeAttribute('data-loading');
    };
    const fallBack = (): void => {
      loaded();
      scrub?.scrollTrigger?.kill();
      scrub?.kill();
      cake?.dispose();
      cake = undefined;
      swap(false, true);
    };

    // Each label hangs from where its layer meets the rim of the slice.
    const hangLabels = (points: LabelPoints): void => {
      for (const label of section.querySelectorAll<HTMLElement>('[data-dive-label]')) {
        const point = points[label.dataset.diveLabel as keyof LabelPoints];
        if (!point) continue;
        label.style.left = `${point.x * 100}%`;
        label.style.top = `${point.y * 100}%`;
      }
    };

    // The speaker button: off until pressed.
    const speaker = section.querySelector<HTMLElement>('[data-dive-sound]');
    let sound = false;
    const toggleSound = (): void => {
      sound = !sound;
      speaker?.setAttribute('aria-pressed', String(sound));
      if (!sound) return;
      audio ??= new AudioContext();
      void audio.resume();
    };
    speaker?.addEventListener('click', toggleSound);

    const build = (scene: DiveCake): void => {
      const find = (selector: string) => gsap.utils.toArray<HTMLElement>(selector, section);
      const pin = section.querySelector<HTMLElement>('.dive-pin')!;
      // Each line arrives at the start of its beat and leaves at the end of it.
      const beats = [
        DIVE.whole,
        [DIVE.cut[0], DIVE.slide[1]],
        [DIVE.sweep[0], DIVE.enter[1]],
        [DIVE.explode[0], DIVE.shatter[1]],
      ] as const;
      let before = 0;

      // Positions on this timeline are fractions of the scroll, from 0 to 1.
      scrub = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: () => `top ${parseFloat(getComputedStyle(pin).top) || 0}px`,
          end: 'bottom bottom',
          scrub: true,
          onUpdate: (self) => {
            scene.setProgress(self.progress);
            // The crunch, as the crust breaks, on the way down only.
            if (sound && before < DIVE.shatter[0] && self.progress >= DIVE.shatter[0]) crunch();
            before = self.progress;
          },
        },
      });
      scrub.to({}, { duration: 1 }, 0);

      find('[data-dive-line]').forEach((line, index) => {
        const [from, to] = beats[index] ?? beats[beats.length - 1]!;
        if (index > 0) scrub!.fromTo(line, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: FADE }, from);
        scrub!.to(line, { opacity: 0, y: -16, duration: FADE }, to - FADE);
      });

      // The circle opens to cover the view, then lifts to show the slice.
      const mask = find('[data-dive-mask]');
      scrub
        .fromTo(mask, { scale: 0 }, { scale: 1, duration: DIVE.enter[1] - DIVE.enter[0], ease: 'power2.in' }, DIVE.enter[0])
        .to(mask, { opacity: 0, duration: DIVE.reveal[1] - DIVE.reveal[0] }, DIVE.reveal[0]);

      // The labels: each leader line draws out, then its words appear.
      find('[data-dive-label]').forEach((label, index) => {
        const start = DIVE.labels[0] + index * 0.015;
        scrub!
          .to(label.querySelector('[data-dive-leader]'), { scaleX: 1, duration: 0.03 }, start)
          .to(label.querySelector('[data-dive-label-text]'), { opacity: 1, duration: 0.02 }, start + 0.02);
      });
      scrub.to(find('[data-dive-labels]'), { opacity: 0, duration: 0.02 }, DIVE.labels[1] - 0.02);

      // The three reasons stamp in, one after another.
      find('[data-dive-reason]').forEach((reason, index) => {
        scrub!.fromTo(
          reason,
          { opacity: 0, scale: 1.4, rotation: index % 2 ? 4 : -4 },
          { opacity: 1, scale: 1, rotation: index % 2 ? 1 : -1, duration: 0.02, ease: 'power3.in' },
          DIVE.reasons[0] + index * 0.03,
        );
      });
    };

    swap(true);
    const stopWaiting = whenNear(section, async () => {
      try {
        const { mountDiveCake } = await import('../../lib/three/dive-cake');
        if (gone) return;
        // Too slow here: back to the drawn version.
        cake = mountDiveCake(mount, { onLabels: hangLabels, onFallback: fallBack });
        loaded();
        build(cake);
      } catch {
        fallBack();
      }
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        gone = true;
        stopWaiting();
        loaded();
        speaker?.removeEventListener('click', toggleSound);
        scrub?.kill();
        cake?.dispose();
        page.removeAttribute('data-dive-on');
      },
      { once: true },
    );
  });
</script>
