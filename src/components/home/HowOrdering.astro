---
// How ordering works: three short numbered lines beside one photo.
import { Picture } from 'astro:assets';
import { ordering } from '../../content/site';
import { PHOTO_WIDTHS, photo, qualityOf } from '../../lib/photos';
import Frame from '../v3/Frame.astro';
import Reveal from '../v3/Reveal.astro';

const PHOTO = 'kitchen-tray-a';
const picture = photo(PHOTO);
---

<section class="px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="ordering-heading">
  <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-[1fr_1fr] md:gap-16">
    <Reveal class="md:order-2">
      <Frame>
        {
          picture && (
            <Picture
              src={picture}
              formats={['avif']}
              fallbackFormat="webp"
              quality={qualityOf(PHOTO)}
              widths={PHOTO_WIDTHS}
              sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 46vw, calc(100vw - 2.8rem)"
              alt="A tray of cheesecake pieces, half topped with Oreo crumb and half with KitKat"
              class="aspect-square w-full object-cover"
            />
          )
        }
      </Frame>
    </Reveal>
    <Reveal delay={0.1}>
      <h2 id="ordering-heading" class="text-5xl leading-tight font-semibold sm:text-6xl">{ordering.heading}</h2>
      <ol class="mt-8 border-t border-[var(--color-hairline)]">
        {
          ordering.steps.map((step, index) => (
            <li class="flex gap-5 border-b border-[var(--color-hairline)] py-5">
              <span class="font-display text-3xl leading-none tabular-nums opacity-70" aria-hidden="true">
                {index + 1}
              </span>
              <span>
                <span class="block font-display text-2xl leading-tight">{step.title}</span>
                <span class="mt-1 block text-sm">{step.detail}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </Reveal>
  </div>
</section>
