---
// How ordering works: three steps, each with a sketch that draws itself.
import { boxLabel, orderPath, ordering } from '../../content/site';
import StorySketch from '../story/StorySketch.astro';
import Button from '../ui/Button.astro';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section class="bg-blush/45 px-5 py-20" data-ordering>
  <SectionTitle label="Three steps" title={ordering.heading} />

  <ol class="mx-auto mt-12 grid max-w-4xl gap-10 sm:grid-cols-3 sm:gap-6">
    {
      ordering.steps.map((step, index) => (
        <li class="text-center" data-ordering-step>
          <StorySketch kind={step.sketch} class="mx-auto w-40 overflow-visible" />
          <p class="label-caps mt-4 opacity-80" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-1 text-3xl leading-tight">{step.title}</h3>
          <p class="mx-auto mt-2 max-w-[16rem] text-sm">{step.detail}</p>
        </li>
      ))
    }
  </ol>

  <p class="mt-12 text-center">
    <Button href={orderPath}>{boxLabel}</Button>
  </p>
</section>

<script>
  import gsap from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { lazyScene } from '../../lib/scene';

  gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger);

  lazyScene('[data-ordering]', (scene) => {
    gsap.utils.toArray<HTMLElement>('[data-ordering-step]', scene).forEach((step, index) => {
      const find = (selector: string) => gsap.utils.toArray<SVGElement>(selector, step);

      gsap
        .timeline({ scrollTrigger: { trigger: step, start: 'top 80%', once: true }, delay: index * 0.15 })
        .from(find('[data-sketch] > :not([data-pop])'), {
          drawSVG: 0,
          duration: 0.6,
          stagger: 0.08,
          ease: 'power1.inOut',
        })
        .from(
          find('[data-pop]'),
          { scale: 0, transformOrigin: '50% 50%', duration: 0.35, stagger: 0.08, ease: 'back.out(3)' },
          '-=0.2',
        );
    });
  });
</script>
