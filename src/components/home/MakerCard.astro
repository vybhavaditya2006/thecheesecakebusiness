---
// A small card for the maker. The story itself lives on /story.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { brand } from '../../content/brand';
import { paths } from '../../content/site';

// The cut-out photo is optional until it has been added to src/assets/photos.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/shlok.webp', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
---

<section class="px-5 pt-16 pb-24">
  <a
    href={paths.story}
    class="maker-card mx-auto flex max-w-md items-center gap-5 rounded-3xl border border-wine/25 bg-blush/40 p-5"
  >
    <span class="block size-24 shrink-0 overflow-hidden rounded-full border-[1.5px] border-wine bg-wine/10">
      {
        photo && (
          <Picture
            src={photo}
            formats={['avif']}
            fallbackFormat="webp"
            quality={80}
            widths={[96, 192, 288]}
            sizes="192px"
            alt=""
            class="maker-face size-full object-cover object-top"
            pictureAttributes={{ class: 'block size-full' }}
          />
        )
      }
    </span>
    <span>
      <span class="label-caps block opacity-80">The maker</span>
      <span class="mt-1 block font-display text-3xl leading-tight font-semibold">Meet {brand.maker}</span>
      <span class="label-caps mt-2 block underline underline-offset-4">Read the story</span>
    </span>
  </a>
</section>

<style>
  .maker-card {
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .maker-face {
    /* Zoom in on the face of the full-length cut-out. */
    transform: scale(1.5);
    transform-origin: 78% 0%;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .maker-card:hover {
      transform: rotate(-1.5deg) scale(1.02);
    }
  }
</style>
