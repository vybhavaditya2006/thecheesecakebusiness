---
// A small card for the maker. The story itself lives on /story.
import { Picture } from 'astro:assets';
import { PHOTO_WIDTHS, photo as master, QUALITY } from '../../lib/photos';
import { brand } from '../../content/brand';
import { delivery } from '../../content/info';
import { paths } from '../../content/site';
import Sticker from '../ui/Sticker.astro';

// The cut-out photo is optional until its master is in src/assets/photos/masters.
const photo = master('shlok');
---

<section class="px-5 pt-16 pb-24">
  <div class="relative mx-auto max-w-md">
  <span class="absolute -top-5 -right-2 z-10 sm:-right-10">
    <Sticker tilt={8}><span class="label-caps text-[0.6rem]">{delivery.madeIn}</span></Sticker>
  </span>
  <a
    href={paths.story}
    class="maker-card mx-auto flex max-w-md items-center gap-5 rounded-3xl border border-wine/25 bg-blush/40 p-5"
  >
    <span class="warm-glow shrink-0"><span class="block size-24 overflow-hidden rounded-full border-[1.5px] border-wine bg-wine/10">
      {
        photo && (
          <Picture
            src={photo}
            formats={['avif']}
            fallbackFormat="webp"
            quality={QUALITY.other}
            widths={PHOTO_WIDTHS}
            sizes="144px"
            alt=""
            class="maker-face size-full object-cover object-top"
            pictureAttributes={{ class: 'block size-full' }}
          />
        )
      }
    </span></span>
    <span>
      <span class="label-caps block opacity-80">The maker</span>
      <span class="mt-1 block font-display text-3xl leading-tight font-semibold">Meet {brand.maker}</span>
      <span class="label-caps mt-2 block underline underline-offset-4">Read the story</span>
    </span>
  </a>
  </div>
</section>

<style>
  .maker-card {
    transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .maker-face {
    /* Zoom in on the face of the full-length cut-out. */
    transform: scale(1.5);
    transform-origin: 78% 0%;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .maker-card:hover {
      transform: rotate(-1.5deg) scale(1.02);
    }
  }
</style>
