---
// Home's first screen: a full-width photo with a light card over it. It is
// kept short enough on a 375 px phone for the contact strip to show under it.
import { Picture } from 'astro:assets';
import { brand } from '../../content/brand';
import { home, orderPath, paths } from '../../content/site';
import { HERO_IMAGE, photo } from '../../lib/photos';
import Button from '../v3/Button.astro';
import Card from '../v3/Card.astro';
import Reveal from '../v3/Reveal.astro';
import Wordmark from '../ui/Wordmark.astro';

// TODO: swap for a daylight photo of a box of five when Shlok has one. This
// WhatsApp photo is only 940 px wide, so it is soft across a wide screen.
const HERO = HERO_IMAGE.name;
const picture = photo(HERO);
// The hero sits under a card, so it can be a little lighter than a product
// shot: it is the page's largest paint on a phone. index.astro preloads it
// with the same settings, so keep them in step (HERO_IMAGE).
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-heading">
  {
    picture && (
      <Picture
        src={picture}
        formats={['avif']}
        fallbackFormat="webp"
        quality={HERO_IMAGE.quality}
        widths={HERO_IMAGE.widths}
        sizes={HERO_IMAGE.sizes}
        loading="eager"
        fetchpriority="high"
        alt="Three clear packs of five cheesecake pieces, side by side, seen from above"
        class="absolute inset-0 -z-10 size-full object-cover"
        pictureAttributes={{ class: 'contents' }}
      />
    )
  }
  <div class="hero-room mx-auto flex max-w-6xl items-end px-4 pt-10 pb-4 sm:items-center sm:px-6 sm:py-16">
    <Reveal class="w-full sm:max-w-md">
      <Card glass class="px-6 py-6 text-center sm:px-10 sm:py-10">
        <h1 id="hero-heading" class="text-[3.4rem] leading-none text-wine sm:text-7xl">
          <Wordmark />
        </h1>
        <p class="mt-2 font-display text-2xl italic sm:text-3xl">{brand.tagline}</p>
        <p class="mx-auto mt-3 max-w-xs text-sm leading-snug sm:text-base">{home.line}</p>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <Button href={orderPath} block>{home.order}</Button>
          <Button href={paths.flavours} block>{home.seeFlavours}</Button>
        </div>
      </Card>
    </Reveal>
  </div>
</section>

<style>
  /* Tall enough to be a hero, short enough on a phone for the contact strip
     to fit on the first screen below it. */
  .hero-room {
    min-height: min(31rem, calc(100svh - 15rem));
  }

  @media (min-width: 40rem) {
    .hero-room {
      min-height: min(44rem, calc(100svh - 14rem));
    }
  }
</style>
