---
// Flavour worlds. One panel per flavour, then a last one pointing to custom
// orders: horizontal and pinned on desktop, stacked snap panels on phones.
// Without motion the same markup is a plain grid of cards. A small switcher
// bite stays in a corner and turns to show whichever flavour is in view.
import { Picture } from 'astro:assets';
import { customOptions } from '../../content/custom';
import { wholeCakes } from '../../content/whole-cakes';
import { flavours } from '../../content/flavours';
import { formatPrice, pricing, saleActive } from '../../content/pricing';
import { biteImage } from '../../lib/bite-images';
import { ingredientImage } from '../../lib/ingredient-images';
import { CUTOUT_WIDTHS, QUALITY } from '../../lib/photos';
import BitePhoto from '../ui/BitePhoto.astro';
import Button from '../ui/Button.astro';
import { paths } from '../../content/site';
import LayerStack from './LayerStack.astro';
import Card from '../v3/Card.astro';

const price = pricing.single;
const count = flavours.length;
const pad = (value: number): string => String(value).padStart(2, '0');
const first = flavours[0]!;
// The custom options by name, as one line.
const customLine = customOptions.map((option) => option.name).join(' · ');

// Where the ingredient cut-outs rest around the bite, as % of the visual
// box: left, top, width, a slight turn, and whether the photo is mirrored, so
// copies of one photo do not look alike. Each flavour uses the first few.
const SPOTS = [
  { left: 0, top: 62, size: 24, turn: -8, flip: false },
  { left: 74, top: 4, size: 20, turn: 12, flip: true },
  { left: 76, top: 66, size: 22, turn: 6, flip: true },
  { left: 4, top: 8, size: 17, turn: -14, flip: false },
  { left: 42, top: 82, size: 16, turn: 18, flip: false },
] as const;
// How many cut-outs each ingredient gets: small ones more, big ones fewer.
const HOW_MANY: Record<string, number> = { blueberries: 5, 'coffee-beans': 5, oreo: 4, biscoff: 4, kitkat: 3 };

---

<section
  class="flavours relative"
  style={`--flavours-count:${count + 1}`}
  aria-labelledby="flavours-heading"
  data-flavours
>
  <!-- Motion only: flavour colour washes, held behind the panels. -->
  <div class="flavours-backdrop" aria-hidden="true">
    <div class="flavours-sticky">
      {flavours.map((flavour) => <div class="flavour-tint absolute inset-0 opacity-0" style={`--accent:${flavour.accent}`} data-flavour-wash />)}
    </div>
  </div>

  <!-- The switcher: a 3D bite that turns like a globe with the scroll. Its
       front half is the flavour in view and its back half the next one. The
       photos under it are what shows without 3D. A tap goes to the next flavour. -->
  <button
    type="button"
    class="flavour-switch"
    aria-label={`Next flavour: ${flavours[1]?.name}`}
    data-flavour-switch
  >
    <span class="flavour-switch-turn" data-switch-turn>
      {
        flavours.map((flavour, index) => (
          <span class:list={['flavour-switch-face', index === 0 && 'is-shown']} data-switch-face>
            <BitePhoto flavour={flavour} sizes="(min-width: 48rem) 9rem, 5rem" priority={index === 0} class="text-[0.6rem]" />
          </span>
        ))
      }
      <span class="flavour-switch-face flavour-switch-again" data-switch-face>Start again</span>
    </span>
    <span class="flavour-switch-3d" data-switch-3d></span>
    <span class="flavour-switch-name" data-switch-name>{first.name}</span>
  </button>

  <div class="flavours-pin">
    <h1 id="flavours-heading" class="flavours-heading">Flavours</h1>

    <ul class="flavours-track" data-flavours-track>
      {
        flavours.map((flavour, index) => (
          <li
            id={flavour.id}
            class="flavour-panel flavour-tint"
            style={`--accent:${flavour.accent}`}
            data-flavour-panel
            data-flavour-id={flavour.id}
            data-flavour-name={flavour.name}
          >
            <div class="flavour-visual relative aspect-square shrink-0" data-flavour-visual>
              {ingredientImage(flavour) &&
                SPOTS.slice(0, HOW_MANY[flavour.ingredientPhoto] ?? 4).map((spot) => (
                  <span
                    class="flavour-ingredient absolute"
                    style={`left:${spot.left}%;top:${spot.top}%;width:${spot.size}%;rotate:${spot.turn}deg`}
                    data-ingredient
                    data-from={spot.left < 50 ? 'left' : 'right'}
                    aria-hidden="true"
                  >
                    <span class="flavour-ingredient-shadow" />
                    <Picture
                      src={ingredientImage(flavour)!}
                      formats={['avif']}
                      fallbackFormat="webp"
                      quality={QUALITY.product}
                      widths={CUTOUT_WIDTHS}
                      sizes={`(min-width: 48rem) calc(min(38vw, 58svh) * ${spot.size / 100}), calc(min(56vw, 21svh) * ${spot.size / 100})`}
                      alt=""
                      loading="lazy"
                      class:list={['relative block h-auto w-full', spot.flip && '-scale-x-100']}
                      pictureAttributes={{ class: 'contents' }}
                    />
                  </span>
                ))}
              {/* A cut-out photo stands larger than the placeholder circle. */}
              <div
                class:list={['absolute', biteImage(flavour.id) ? 'inset-[14%]' : 'inset-[27%]']}
                data-flavour-bite
              >
                <BitePhoto
                  flavour={flavour}
                  sizes="(min-width: 48rem) min(28vw, 42svh), min(40vw, 16svh)"
                  priority={index === 0}
                  class="text-[clamp(0.8rem,2.2vw,1.6rem)]"
                />
            </div>
            </div>

            <div class="flavour-text flex flex-col gap-3">
              <p class="label-caps">
                {pad(index + 1)} / {pad(count)}
              </p>
              <h2 class="flavour-name leading-[0.9]">{flavour.name}</h2>
              <p class="max-w-sm">{flavour.note}</p>
              {/* Shown only once Shlok has confirmed them (see flavours.ts). */}
              {(flavour.calories !== null || flavour.ingredients?.length) && (
                <p class="max-w-sm text-sm opacity-70">
                  {[flavour.calories !== null && `${flavour.calories} kcal a piece`, flavour.ingredients?.join(', ')]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              )}
              <LayerStack flavour={flavour} />
              <p class="flex items-center gap-3">
                {saleActive && (
                  <s class="text-lg">
                    <span class="sr-only">Was </span>
                    {formatPrice(price.regular)}
                  </s>
                )}
                {/* The price tag. */}
                <span class="flavour-tag">
                  <span class="font-display text-3xl leading-none font-semibold">
                    {formatPrice(saleActive ? price.offer : price.regular)}
                  </span>
                  <span class="label-caps text-[0.65rem]">a piece</span>
                </span>
              </p>
              <Button class="mt-1" data-add-to-box={flavour.id}>
                Add to box<span class="sr-only">: {flavour.name}</span>
              </Button>
              <Card as="a" href={`${paths.flavours}#whole`} class="flavour-whole label-caps mt-2 px-4 py-3 text-[0.65rem]">
                {wholeCakes.also}<span aria-hidden="true"> →</span>
              </Card>
            </div>
          </li>
        ))
      }
      <li class="flavour-panel flavour-else" data-flavour-panel>
        <div class="flavour-text flex flex-col gap-3">
          <p class="label-caps">{'Custom & gifts'}</p>
          <h2 class="flavour-name leading-[0.9]">Something else?</h2>
          <p class="max-w-sm">{customLine}</p>
          <Button class="mt-1" href={paths.custom}>{'See Custom & Gifts'}</Button>
        </div>
      </li>
    </ul>
  </div>
</section>

<style is:global>
  /* ---- Calm version (no "motion" class on <html>): a grid of five cards. */
  .flavour-tint {
    background: color-mix(in srgb, var(--accent) 20%, var(--color-cream));
  }

  .flavours-backdrop,
  [data-ingredient] {
    display: none;
  }

  .flavours-heading {
    padding: 4rem 1.25rem 2rem;
    font-size: 2.25rem;
    text-align: center;
  }

  .flavours-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0 1.25rem 4rem;
  }

  .flavour-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    text-align: center;
  }

  .flavour-visual {
    width: 11rem;
  }

  .flavour-text {
    align-items: center;
  }

  .flavour-name {
    font-size: 2.25rem;
  }

  .flavour-else {
    justify-content: center;
    border: 1.5px dashed rgb(122 31 43 / 0.4);
    background: color-mix(in srgb, var(--color-blush) 45%, var(--color-cream));
  }

  .flavour-else .flavour-text {
    align-items: center;
    text-align: center;
  }

  /* An ingredient cut-out, and the soft shadow where it rests. */
  .flavour-ingredient-shadow {
    position: absolute;
    inset: auto 8% -6% 8%;
    height: 22%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(74 15 24 / 0.28), transparent);
  }

  .flavour-whole {
    width: fit-content;
  }

  /* The price, as a tag on a string. */
  .flavour-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 1.5rem;
    border-radius: 0.5rem 999px 999px 0.5rem;
    background: var(--color-gold);
    background-image: radial-gradient(circle at 0.75rem 50%, var(--color-cream) 0.2rem, transparent 0.24rem);
    color: var(--color-wine-deep);
    white-space: nowrap;
    transform: rotate(-2deg);
  }

  /* The switcher: only in the animated version. */
  .flavour-switch {
    display: none;
  }

  .motion .flavour-switch {
    display: block;
    position: fixed;
    top: calc(var(--flavours-top) + 0.75rem);
    right: 1rem;
    z-index: 30;
    width: 3.75rem;
    height: 3.75rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
    /* Depth for the turn. */
    perspective: 26rem;
  }

  .motion [data-inside] .flavour-switch {
    opacity: 1;
    pointer-events: auto;
  }

  .flavour-switch-turn,
  .flavour-switch-face {
    position: absolute;
    inset: 0;
  }

  /* Only the flavour in view shows; the swap happens edge-on, unseen. */
  .flavour-switch-face {
    opacity: 0;
  }

  .flavour-switch-face.is-shown {
    opacity: 1;
  }

  .flavour-switch-again {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(122 31 43 / 0.4);
    border-radius: 50%;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .flavour-switch-name {
    display: none;
  }

  /* Once the 3D bite is in, the photo steps aside. */
  .flavour-switch[data-three] .flavour-switch-turn {
    visibility: hidden;
  }

  .flavour-switch-3d {
    position: absolute;
    inset: -22%;
    pointer-events: none;
  }

  /* ---- Animated version: stacked screen-high panels (phones). */
  .motion [data-flavours] {
    --flavours-top: 6.25rem;
    --flavours-height: calc(100svh - var(--flavours-top));
    height: calc(var(--flavours-height) * var(--flavours-count));
  }

  /* Spans the whole section; its child sticks for exactly that long. */
  .motion .flavours-backdrop {
    display: block;
    position: absolute;
    inset: 0;
  }

  .motion .flavours-sticky {
    position: sticky;
    top: var(--flavours-top);
    height: var(--flavours-height);
    overflow: clip;
  }

  .motion .flavours-pin {
    position: relative;
  }

  .motion .flavours-heading {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    z-index: 1;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .motion .flavours-track {
    display: block;
    max-width: none;
    padding: 0;
  }

  .motion .flavour-panel {
    justify-content: center;
    height: var(--flavours-height);
    padding: 2.5rem 1.25rem 1rem;
    border-radius: 0;
    background: none;
  }

  .motion .flavour-visual {
    width: min(56vw, 21svh);
  }

  .motion .flavour-else {
    border: 0;
    background: none;
  }

  .motion .flavour-name {
    font-size: 3rem;
  }

  .motion [data-ingredient] {
    display: block;
  }

  /* Hidden until the flavour arrives. */
  .motion [data-flavour-bite],
  .motion [data-ingredient] {
    opacity: 0;
  }

  /* Phones: a slimmer "whole cheesecake" tile, and on short screens
     everything a little tighter, so a panel always fits its screen. */
  @media (max-width: 47.99rem) {
    .motion .flavour-whole {
      padding: 0.5rem 0.9rem;
    }
  }

  @media (max-width: 47.99rem) and (max-height: 44rem) {
    .motion .flavour-panel {
      gap: 0.6rem;
      padding-top: 2.25rem;
    }

    .motion .flavour-text {
      gap: 0.45rem;
    }

    .motion .flavour-name {
      font-size: 2.4rem;
    }

    .motion .flavour-visual {
      width: min(50vw, 19svh);
    }
  }

  /* ---- Animated version: pinned, horizontal (desktop). */
  @media (min-width: 48rem) {
    .motion .flavours-pin {
      position: sticky;
      top: var(--flavours-top);
      height: var(--flavours-height);
      overflow: clip;
    }

    .motion .flavours-track {
      display: flex;
      height: 100%;
      will-change: transform;
    }

    .motion .flavour-panel {
      flex: 0 0 100%;
      flex-direction: row;
      gap: 5vw;
      height: 100%;
      padding: 2rem 6vw;
      text-align: left;
    }

    .motion .flavour-visual {
      width: min(38vw, 58svh);
    }

    .motion .flavour-text {
      align-items: flex-start;
    }

    .motion .flavour-else .flavour-text {
      align-items: center;
    }

    .motion .flavour-switch {
      top: auto;
      right: 2.25rem;
      bottom: 3rem;
      width: 6.5rem;
      height: 6.5rem;
    }

    /* On wide screens the flavour's name sits under its photo. */
    .flavour-switch-name {
      display: block;
      position: absolute;
      inset: 100% -2rem auto;
      padding-top: 0.5rem;
      font-size: 0.58rem;
      font-weight: 500;
      letter-spacing: 0.25em;
      text-align: center;
      text-transform: uppercase;
      opacity: 0.75;
    }

    .motion .flavour-name {
      font-size: clamp(3.5rem, 8.5vw, 8rem);
    }
  }

</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { finePointer, reducedMotion } from '../../lib/motion';
  import { addBite, isFlavourId } from '../../lib/order-store';
  import { getLenis } from '../../lib/smooth-scroll';
  import { canUse3D, whenStirred } from '../../lib/three/support';
  import type { SwitcherBite } from '../../lib/three/switcher-bite';

  gsap.registerPlugin(ScrollTrigger);

  // Registered once; works in every mode, including reduced motion.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.<HTMLElement>('[data-add-to-box]');
    const id = button?.dataset.addToBox;
    if (!button || !isFlavourId(id)) return;
    addBite(id);
  });

  // ---- The scene itself.
  const build = (scene: HTMLElement): (() => void) => {
    const find = (selector: string, within: Element = scene) =>
      gsap.utils.toArray<HTMLElement>(selector, within);
    const pin = scene.querySelector<HTMLElement>('.flavours-pin')!;
    const backdrop = scene.querySelector<HTMLElement>('.flavours-sticky')!;
    const track = scene.querySelector<HTMLElement>('[data-flavours-track]')!;
    const panels = find('[data-flavour-panel]');
    const washes = find('[data-flavour-wash]');
    const steps = panels.length - 1;

    let index = 0; // flavour nearest the middle of the scroll
    let inside = false; // is the section on screen
    let active = -1; // flavour currently shown, -1 for none
    let arrival: gsap.core.Timeline | undefined;

    // ---- The switcher bite.
    const button = scene.querySelector<HTMLElement>('[data-flavour-switch]')!;
    const turner = button.querySelector<HTMLElement>('[data-switch-turn]')!;
    const faces = gsap.utils.toArray<HTMLElement>('[data-switch-face]', button);
    const nameTag = button.querySelector<HTMLElement>('[data-switch-name]')!;
    // Scrolls the page to a panel, in either layout.
    const goTo = (target: number): void => {
      const box = scene.getBoundingClientRect();
      const from = box.top + window.scrollY - (parseFloat(getComputedStyle(backdrop).top) || 0);
      const to = box.bottom + window.scrollY - window.innerHeight;
      const y = from + (target / steps) * (to - from);

      const lenis = getLenis();
      if (lenis) lenis.scrollTo(y, { duration: 1 });
      else window.scrollTo(0, y);
    };
    // The name and label that go with the panel now showing.
    const dress = (panel: number): void => {
      const now = panels[panel];
      const next = panels[(panel + 1) % panels.length];
      nameTag.textContent = now?.dataset.flavourName ?? '';
      const nextName = next?.dataset.flavourName;
      button.setAttribute('aria-label', nextName ? `Next flavour: ${nextName}` : 'More than flavours');
    };

    // The switcher turns with the scroll about its upright axis: half a turn
    // from one flavour to the next. Half way it is edge-on, and that is when
    // the next flavour's photo takes its place.
    const setTurn = gsap.quickSetter(turner, 'rotationY', 'deg');
    let facing = 0;
    let turned = 0;
    let deepBite: SwitcherBite | undefined;
    let gone = false;
    const turnTo = (position: number): void => {
      turned = position;
      deepBite?.setPosition(position);
      const nearest = Math.round(position);
      setTurn((position - nearest) * 180);
      if (nearest === facing) return;
      facing = nearest;
      faces.forEach((face, place) => face.classList.toggle('is-shown', place === nearest));
      dress(nearest);
      deepBite?.pulse();
    };

    const load3D = (): void => {
      if (gone) return;
      import('../../lib/three/switcher-bite')
        .then(({ mountSwitcherBite }) => {
          if (gone) return;
          const mount = button.querySelector<HTMLElement>('[data-switch-3d]')!;
          const stops = panels.map((panel) => {
            const id = panel.dataset.flavourId;
            return isFlavourId(id) ? id : null;
          });
          deepBite = mountSwitcherBite(mount, stops, {
            // Too slow here: back to the photos.
            onFallback: () => {
              deepBite = undefined;
              button.removeAttribute('data-three');
            },
          });
          deepBite.setPosition(turned);
          button.dataset.three = '';
        })
        .catch(() => {});
    };
    // The photo shows until the visitor has done something; then the 3D bite loads.
    if (canUse3D()) whenStirred(load3D);

    // A tap goes on to the next panel.
    const onTap = (): void => goTo((index + 1) % panels.length);
    button.addEventListener('click', onTap);

    // The bite slides up and fades in; the ingredients slide in from
    // their own side and settle.
    const arrive = (panel: HTMLElement): void => {
      const visual = panel.querySelector<HTMLElement>('[data-flavour-visual]');
      // The last panel has no bite to bring in.
      if (!visual) return;

      arrival?.kill();
      arrival = gsap.timeline().fromTo(
        find('[data-flavour-bite]', panel),
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 1, ease: 'expo.out' },
        0,
      );

      find('[data-ingredient]', panel).forEach((piece, order) => {
        const away = (piece.dataset.from === 'left' ? -1 : 1) * visual.clientWidth * 0.18;
        arrival!.fromTo(
          piece,
          { x: away, opacity: 0 },
          { x: 0, opacity: 1, duration: 1.1, ease: 'expo.out' },
          0.15 + order * 0.05,
        );
      });

    };

    const show = (next: number): void => {
      if (next === active) return;
      const previous = panels[active];
      if (previous) {
        gsap.set(find('[data-flavour-bite], [data-ingredient]', previous), { opacity: 0 });
      }

      // The background warms to the new flavour's colour.
      washes.forEach((wash, wave) => {
        gsap.to(wash, { opacity: wave === next ? 1 : 0, duration: 1, ease: 'power2.out', overwrite: true });
      });

      active = next;
      const panel = panels[next];
      if (panel) arrive(panel);
    };
    const sync = (): void => show(inside ? index : -1);

    const start = (): string => `top ${parseFloat(getComputedStyle(backdrop).top) || 0}px`;
    const follow = (self: ScrollTrigger): void => {
      index = Math.round(self.progress * steps);
      turnTo(self.progress * steps);
      sync();
    };

    const media = gsap.matchMedia();

    // Desktop: the track slides sideways while the section is pinned.
    media.add('(min-width: 48rem)', () => {
      gsap.to(track, {
        x: () => -(track.scrollWidth - pin.clientWidth),
        ease: 'none',
        scrollTrigger: {
          trigger: scene,
          start,
          end: 'bottom bottom',
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: follow,
        },
      });
    });

    // Phones: stacked panels, with a gentle snap on touch screens.
    media.add('(max-width: 47.99rem)', () => {
      ScrollTrigger.create({
        trigger: scene,
        start,
        end: 'bottom bottom',
        onUpdate: follow,
        snap: finePointer()
          ? undefined
          : { snapTo: 1 / steps, duration: { min: 0.2, max: 0.5 }, delay: 0.1, ease: 'power1.inOut' },
      });
    });

    const asked = panels.findIndex((panel) => panel.id && panel.id === window.location.hash.slice(1));
    if (asked > 0) {
      requestAnimationFrame(() => {
        ScrollTrigger.refresh();
        goTo(asked);
      });
    }

    const presence = ScrollTrigger.create({
      trigger: scene,
      start: 'top 60%',
      end: 'bottom 40%',
      onToggle: (self) => {
        inside = self.isActive;
        scene.toggleAttribute('data-inside', inside);
        sync();
      },
    });

    // Keyboard: tabbing to a button in a panel that is off to the side
    // scrolls the page to that flavour, so focus is never out of sight.
    const reveal = (event: FocusEvent): void => {
      const panel = (event.target as Element).closest<HTMLElement>('[data-flavour-panel]');
      const target = panel ? panels.indexOf(panel) : -1;
      if (target < 0 || target === index || !window.matchMedia('(min-width: 48rem)').matches) return;

      goTo(target);
    };
    scene.addEventListener('focusin', reveal);

    return () => {
      gone = true;
      deepBite?.dispose();
      button.removeEventListener('click', onTap);
      scene.removeEventListener('focusin', reveal);
      media.revert();
      presence.kill();
      arrival?.kill();
    };
  };

  document.addEventListener('astro:page-load', () => {
    const scene = document.querySelector<HTMLElement>('[data-flavours]');
    if (!scene || reducedMotion()) return;

    let cleanUp: (() => void) | undefined;

    // Build the scene only when it is about a screen away.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        cleanUp = build(scene);
      },
      { rootMargin: '100% 0px' },
    );
    observer.observe(scene);

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        cleanUp?.();
      },
      { once: true },
    );
  });
</script>
