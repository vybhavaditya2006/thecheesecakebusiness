---
// A small sketch of one flavour's ingredient, filled with the flavour accent
// (read from the --accent custom property of an ancestor).
import type { FlavourId } from '../../content/flavours';

interface Props {
  kind: FlavourId;
  class?: string;
  [attribute: string]: unknown;
}

const { kind, class: className, ...rest } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="var(--accent)"
  stroke="var(--color-wine)"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  {
    kind === 'blueberry' && (
      <>
        <circle cx="20" cy="20" r="15" />
        <path d="M14 13l6 4 6-4M20 17v-6" fill="none" stroke="var(--color-cream)" />
      </>
    )
  }
  {
    kind === 'kitkat' && (
      <>
        <rect x="4" y="12" width="32" height="16" rx="4" />
        <path d="M15 12v16M25 12v16" fill="none" opacity="0.5" />
        <path d="M8 17h4M18 17h4M28 17h4" fill="none" stroke="var(--color-cream)" />
      </>
    )
  }
  {
    kind === 'oreo' && (
      <>
        <path d="M7 17l8-10 13 3 6 10-5 11-13 3-8-7z" />
        <path d="M15 17l4 2M22 25l4-2M20 12l2 1" fill="none" stroke="var(--color-cream)" />
      </>
    )
  }
  {
    kind === 'coffee' && (
      <g transform="rotate(30 20 20)">
        <ellipse cx="20" cy="20" rx="11" ry="15" />
        <path d="M20 6c-5 6 5 10 0 14s5 9 0 14" fill="none" stroke="var(--color-cream)" />
      </g>
    )
  }
  {
    kind === 'biscoff' && (
      <>
        <rect x="5" y="10" width="30" height="20" rx="5" />
        <path
          d="M11 17h18M11 23h18"
          fill="none"
          stroke="var(--color-cream)"
          stroke-dasharray="2 3"
        />
      </>
    )
  }
</svg>
