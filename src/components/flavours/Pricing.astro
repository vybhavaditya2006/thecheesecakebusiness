---
// Pricing: two cards. On entering view the offer price fades up into place
// beside the old one, struck through.
import { Picture } from 'astro:assets';
import { packsOfFive } from '../../content/photos';
import { formatPrice, pricing, saleActive } from '../../content/pricing';
import { PHOTO_WIDTHS, photo, qualityOf } from '../../lib/photos';
import SectionTitle from '../ui/SectionTitle.astro';
import Frame from '../v3/Frame.astro';

const cards = [
  { ...pricing.box, blurb: 'Any mix of flavours, in a tray of five in a clear sleeve.', perPiece: true },
  { ...pricing.single, blurb: 'For when one is all you want.', perPiece: false },
];
const packs = photo(packsOfFive.name);
const boxPrice = saleActive ? pricing.box.offer : pricing.box.regular;
const perPiece = formatPrice(Math.round(boxPrice / pricing.box.bites));
---

<section class="bg-blush/45 px-5 py-20" data-pricing>
  <SectionTitle label={saleActive ? 'Launch prices' : 'Prices'} title="Same price, every flavour" />

  <ul class="mx-auto mt-14 grid max-w-3xl gap-10 sm:grid-cols-2 sm:gap-8">
    {
      cards.map((card) => (
        <li class="relative rounded-3xl border border-wine/25 bg-cream p-8 text-center" data-price-card>
          <h3 class="label-caps font-sans">{card.label}</h3>

          <p class="mt-6 flex items-baseline justify-center gap-4">
            {saleActive && (
              <s class="font-display text-3xl opacity-80">
                <span class="sr-only">Was </span>
                {formatPrice(card.regular)}
              </s>
            )}
            <span class="inline-block font-display text-7xl leading-none font-semibold" data-price-offer>
              {formatPrice(saleActive ? card.offer : card.regular)}
            </span>
          </p>

          <p class="mt-5 text-sm">{card.blurb}</p>
          {card.perPiece && <p class="label-caps mt-3 text-[0.65rem]">{perPiece} a piece in a box of five</p>}
        </li>
      ))
    }
  </ul>

  {
    packs && (
      <Frame class="mx-auto mt-16 w-[62vw] max-w-[18rem]">
        <Picture
          src={packs}
          formats={['avif']}
          fallbackFormat="webp"
          quality={qualityOf(packsOfFive.name)}
          widths={PHOTO_WIDTHS}
          sizes="(min-width: 40rem) 18rem, 62vw"
          alt={packsOfFive.alt}
          class="w-full"
        />
      </Frame>
    )
  }
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { lazyScene } from '../../lib/scene';

  gsap.registerPlugin(ScrollTrigger);

  lazyScene('[data-pricing]', (scene) => {
    gsap.utils.toArray<HTMLElement>('[data-price-card]', scene).forEach((card) => {
      const find = (selector: string) => gsap.utils.toArray<HTMLElement>(selector, card);

      gsap
        .timeline({ scrollTrigger: { trigger: card, start: 'top 78%', once: true } })
        .from(find('[data-price-offer]'), { y: 12, opacity: 0, duration: 0.8, ease: 'expo.out' });
    });
  });
</script>
