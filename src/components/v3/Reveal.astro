---
// The one reveal on the site: a whole block slides up a little and fades in
// as it comes into view, once. Styles are in global.css; with reduced motion
// (or no JavaScript) the block is simply there.
interface Props {
  as?: 'div' | 'li' | 'figure' | 'article';
  // Seconds to wait, for blocks side by side.
  delay?: number;
  class?: string;
}

const { as: Tag = 'div', delay, class: className } = Astro.props;
---

<Tag class={className} style={delay ? `--reveal-delay:${delay}s` : undefined} data-reveal>
  <slot />
</Tag>

<script>
  import { reducedMotion } from '../../lib/motion';

  document.addEventListener('astro:page-load', () => {
    const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-revealed)');
    if (!blocks.length) return;
    if (reducedMotion() || !('IntersectionObserver' in window)) {
      blocks.forEach((block) => block.classList.add('is-revealed'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      },
      // A little before the block is fully in, so it never arrives late.
      { rootMargin: '0px 0px -8% 0px' },
    );
    blocks.forEach((block) => observer.observe(block));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  });
</script>
