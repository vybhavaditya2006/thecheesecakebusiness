---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/pinyon-script/400.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import BiteCursor from '../components/ui/BiteCursor.astro';
import Curtain from '../components/ui/Curtain.astro';
import Footer from '../components/ui/Footer.astro';
import Nav from '../components/ui/Nav.astro';
import SaleRibbon from '../components/ui/SaleRibbon.astro';
import { brand } from '../content/brand';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = brand.pitch } = Astro.props;
const pageTitle = title ? `${title} · ${brand.name}` : `${brand.name} — ${brand.tagline}`;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3E7DA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      // Marks the page as animated so headings can start hidden without a flash.
      (() => {
        const mark = () => {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('motion');
          }
        };
        mark();
        document.addEventListener('astro:after-swap', mark);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-50">
      <SaleRibbon />
      <Nav />
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <BiteCursor />
    <Curtain />

    <script>
      import { startSmoothScroll, stopSmoothScroll } from '../lib/smooth-scroll';

      document.addEventListener('astro:page-load', startSmoothScroll);
      document.addEventListener('astro:before-swap', stopSmoothScroll);
    </script>
  </body>
</html>
