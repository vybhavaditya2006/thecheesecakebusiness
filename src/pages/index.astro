---
import DeliveryFaq from '../components/home/DeliveryFaq.astro';
import Flavours from '../components/home/Flavours.astro';
import Hero from '../components/home/Hero.astro';
import LocalBusiness from '../components/home/LocalBusiness.astro';
import MadeYourWay from '../components/home/MadeYourWay.astro';
import Pricing from '../components/home/Pricing.astro';
import Story from '../components/home/Story.astro';
import WhyBites from '../components/home/WhyBites.astro';
import Divider from '../components/ui/Divider.astro';
import Base from '../layouts/Base.astro';
---

<Base>
