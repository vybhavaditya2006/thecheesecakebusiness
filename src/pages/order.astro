---
import { getImage } from 'astro:assets';
import OrderApp from '../components/order/OrderApp.tsx';
import type { BiteImages } from '../components/order/parts';
import { flavours } from '../content/flavours';
import { seo } from '../content/site';
import { biteImage } from '../lib/bite-images';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { saleActive, formatPrice, pricing } from '../content/pricing';
import Base from '../layouts/Base.astro';

const key = saleActive ? 'offer' : 'regular';

// The island is React, so Astro optimises the bite photos here and passes
// their URLs in. Flavours without a photo are left out and show a placeholder.
const biteImages: BiteImages = {};
for (const flavour of flavours) {
  const src = biteImage(flavour.id);
  if (!src) continue;
  const [avif, webp] = await Promise.all(
    (['avif', 'webp'] as const).map((format) => getImage({ src, width: 192, format, quality: 80 })),
  );
  if (avif && webp) biteImages[flavour.id] = { avif: avif.src, webp: webp.src };
}
---

<Base title={seo.order.title} description={seo.order.description}>
  <!-- Kept short on phones so the box and the flavours share one screen. -->
  <section class="px-5 pt-6 pb-4 text-center sm:pt-12 sm:pb-8">
    <SectionTitle as="h1" label="Order" title="Pack your box" immediate />
    <p class="mt-4 hidden text-sm sm:block">
      {pricing.box.label}: <strong>{formatPrice(pricing.box[key])}</strong> · {pricing.single.label}:{' '}
      <strong>{formatPrice(pricing.single[key])}</strong>
    </p>
  </section>

  <!-- The order lives in the browser, so the builder only renders there. -->
  <!-- A full screen is held for the builder so nothing below jumps when it appears. -->
  <div class="min-h-svh">
    <OrderApp client:only="react" biteImages={biteImages}>
      <p slot="fallback" class="px-5 py-24 text-center text-sm">Setting out the box…</p>
    </OrderApp>
  </div>
</Base>

<style is:global>
  /* Keep the footer clear of the order bar pinned to the bottom on phones. */
  @media (max-width: 63.99rem) {
    body:has([data-order-bar]) footer {
      padding-bottom: 7rem;
    }
  }
</style>
