---
import ContactStrip from '../components/home/ContactStrip.astro';
import Faq from '../components/info/Faq.astro';
import FlavourFacts from '../components/info/FlavourFacts.astro';
import InfoBlocks from '../components/info/InfoBlocks.astro';
import Label from '../components/v3/Label.astro';
import Reveal from '../components/v3/Reveal.astro';
import { contact } from '../content/info';
import { seo } from '../content/site';
import Base from '../layouts/Base.astro';
---

<Base title={seo.info.title} description={seo.info.description}>
  <header class="px-4 pt-12 pb-10 sm:px-6 sm:pt-20 sm:pb-14">
    <Reveal class="mx-auto max-w-6xl">
      <Label>The practical bits</Label>
      <h1 class="mt-3 text-5xl leading-tight font-semibold sm:text-6xl">Good to know</h1>
    </Reveal>
  </header>
  <InfoBlocks />
  <FlavourFacts />
  <Faq />
  <section class="border-t border-[var(--color-hairline)] pt-12 pb-20 sm:pt-16 sm:pb-28" aria-labelledby="contact-heading">
    <Reveal class="px-4 text-center sm:px-6">
      <Label>Contact</Label>
      <h2 id="contact-heading" class="mt-3 text-4xl leading-tight font-semibold sm:text-5xl">{contact.heading}</h2>
      <p class="mx-auto mt-4 max-w-md text-sm">{contact.summary}</p>
    </Reveal>
    <div class="mt-6">
      <ContactStrip />
    </div>
  </section>
</Base>
